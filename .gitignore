# ---- Dependencies ----
node_modules/
plugins/*/node_modules/

# ---- Build outputs (generated; rebuildable) ----
dist/
release/
runtime-dist/
bundled-kernel/
plugins/*/lib/
plugins/*/.test-dist/

# ---- Runtime artifacts ----
*.tgz

# ---- Logs ----
logs/
*.log

# ---- Local scratch / probes / one-off experiments ----
scratch/

# ---- Local agent context cache (context-codebase skill) ----
repo/

# ---- Generated release outputs (local only; rebuilt per release) ----
release-notes.md

# ---- Package locks: sibling plugins do not track lockfiles ----
plugins/*/package-lock.json

# ---- IDE / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/

# ---- Environment secrets ----
.env
.env.*
!.env.example
