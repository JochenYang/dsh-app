{
  "name": "@dsh-app/plugin-todo",
  "description": "DSH APP todo board: one workbench card and its full-page view for tasks with deadlines, lists, priorities, steps and repeat rules, completion statistics by week, month and year, and four host tools so the model can record, edit or tick a task from a conversation.",
  "version": "0.1.1",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-connection": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-home-paths": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.5",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
