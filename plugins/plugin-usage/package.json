{
  "name": "@dsh-app/plugin-usage",
  "description": "DSH APP usage statistics: dual-face plugin (host capture/aggregation routes + the maintenance section's usage tab with heatmap and daily trend chart) over session logs.",
  "version": "0.2.9",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "^3.0.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.3",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session": "^0.1.7-alpha.1",
    "@deepseek-ai/dsh-session-persistence": "^0.1.7-alpha.1",
    "@deepseek-ai/schemastery": "3.18.3",
    "@types/react": "18.3.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
