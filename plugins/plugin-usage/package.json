{
  "name": "@dsh-app/plugin-usage",
  "description": "DSH APP usage statistics: dual-face plugin (host capture/aggregation routes + settings-page section with heatmap and daily trend chart) over session logs.",
  "version": "0.1.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-home-paths": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "^0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-persistence": "^0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "^3.0.0",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-home-paths": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session": "0.1.2-alpha.3",
    "@deepseek-ai/dsh-session-persistence": "0.1.2-alpha.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@types/react": "18.3.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
