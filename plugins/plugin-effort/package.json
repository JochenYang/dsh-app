{
  "name": "@dsh-app/plugin-effort",
  "description": "Reasoning-effort slider for DSH: a draggable track inside the official model menu's effort row, so a level is one drag instead of a drill-in and a click. Levels come from the current model's own advertised list and are resolved by id, never by position.",
  "version": "0.2.7",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-store": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.5",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-store": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.1-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.5",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.1",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
