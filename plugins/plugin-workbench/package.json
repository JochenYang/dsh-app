{
  "name": "@dsh-app/plugin-workbench",
  "description": "DSH APP workbench hub: one sidebar entry and one full-page container that domain workbenches register into. A domain contributes a card and declares how the card enters its own surface — a view inside the container, or a jump into a workspace session where its session-scoped surface mounts. The container owns the seat, the page and the extension slots; it owns no domain behaviour.",
  "version": "0.1.0",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-locale": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.2.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.1-rc.1",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.1",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
