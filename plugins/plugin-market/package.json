{
  "name": "@dsh-app/plugin-market",
  "description": "DSH APP plugin market: a sidebar footer entry that opens a market panel over catalog sources (https JSON directories) to browse and install/uninstall npm-packaged dsh plugins into the current profile via the kernel's own plugin CLI.",
  "version": "0.2.2",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.7-alpha.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-client-connection": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-locale": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-alpha.2",
    "@deepseek-ai/dsh-home-paths": "^0.1.7-alpha.2",
    "@types/node": "^22.10.2",
    "@types/react": "18.3.1",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT"
}
