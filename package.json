{
  "name": "dsh-app",
  "productName": "DSH App",
  "version": "0.1.0",
  "description": "DSH App — branded desktop client for DeepSeek Harness (dsh). macOS / Windows / Linux.",
  "author": {
    "name": "dsh-app contributors",
    "email": "JochenYang@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "runtime:build": "node scripts/build-runtime.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "semver": "^7.6.3",
    "tar": "^6.2.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@types/node": "^22.10.2",
    "@types/semver": "^7.5.8",
    "@types/tar": "^6.1.13",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
