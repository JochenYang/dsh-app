{
  "name": "dsh-app",
  "productName": "DSH APP",
  "version": "0.16.0",
  "description": "DSH APP — branded desktop client for DeepSeek Harness (dsh). macOS / Windows / Linux.",
  "author": {
    "name": "dsh-app contributors",
    "email": "JochenYang@users.noreply.github.com"
  },
  "license": "MIT",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "check:graph": "node scripts/check-plugin-graph.mjs",
    "check:plugins": "node scripts/check-plugin-compat.mjs",
    "check:touchpoints": "node scripts/check-touchpoints.mjs",
    "check:touchpoints:gate": "node scripts/check-touchpoints.mjs --check",
    "check:surface": "node scripts/kernel-surface.mjs",
    "check:slots": "node scripts/check-slot-registrations.mjs",
    "dev": "node scripts/dev.mjs",
    "dist": "npm run build && node scripts/prepare-bundled-kernel.mjs && electron-builder",
    "dist:linux": "npm run build && node scripts/prepare-bundled-kernel.mjs linux && electron-builder --linux",
    "dist:mac": "npm run build && node scripts/prepare-bundled-kernel.mjs darwin && electron-builder --mac",
    "dist:win": "npm run build && node scripts/prepare-bundled-kernel.mjs win32 && electron-builder --win",
    "icon:build": "python scripts/build-icons.py",
    "icon:gen": "node scripts/gen-icon.mjs",
    "primary-runtime:build": "node scripts/build-primary-runtime.mjs",
    "profiles:audit": "node scripts/profile-supply-chain.mjs audit",
    "profiles:peers": "node scripts/profile-supply-chain.mjs peers",
    "profiles:prune": "node scripts/profile-supply-chain.mjs prune",
    "runtime:build": "node scripts/build-runtime.mjs",
    "smoke:package": "node scripts/smoke-package.mjs",
    "start": "npm run build && electron .",
    "test": "npm run build && node scripts/ensure-electron.mjs && node --test \"test/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify": "node scripts/smoke-suite.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "semver": "^7.6.3",
    "tar": "^6.2.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-remotes": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-api-settings-controller": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-modules": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.2.0-rc.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.1",
    "@types/semver": "^7.5.8",
    "@types/tar": "^6.1.13",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2"
  }
}
